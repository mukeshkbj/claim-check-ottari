# Copy this file to .env and paste your Otari workspace key (starts with otk_).
# .env is git-ignored, so the key never gets committed.
OTARI_API_KEY=otk_your_key_here
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1
# Pick an open-weight model from the Models tab on otari.ai (provider/model format)
OTARI_MODEL=deepseek/deepseek-v4-pro-0813

# Per-volunteer keys (each created in the Otari dashboard with its own monthly budget)
VOLUNTEER_KEY_ALICE=
VOLUNTEER_KEY_BOB=
